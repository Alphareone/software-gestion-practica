# Plantilla de configuración por entorno.
# Copiar como .env y completar. El archivo .env NO se versiona.
#
# Los valores booleanos aceptan: true/false, 1/0, yes/no, on/off.
# Un valor no reconocido cae al valor por defecto indicado en cada caso.

# ── Base de datos ──
DB_HOST=gestion_db
DB_PORT=3306
DB_USER=gestion_user
DB_PASS=gestion_pass
DB_NAME=gestion_db

# ── Aplicación ──
# URLROOT: dejar comentado en local, config.php lo detecta solo.
# Definir en producción, incluyendo el subdirectorio si lo hay.
#URLROOT=https://software.epracticas.cl
APP_ENV=development
APP_EMAIL=

# ── Cifrado de tokens y secretos guardados en base de datos ──
# 32 bytes en hexadecimal (64 caracteres).
# Generar con: php -r "echo bin2hex(random_bytes(32));"
# Obligatoria cuando APP_ENV=production.
# Cambiarla vuelve indescifrables los secretos ya guardados: para rotarla hay
# que re-cifrar client_secret y access_token de todas las conexiones.
ENCRYPTION_KEY=

# ── MercadoLibre ──
# Las credenciales de la aplicación se cargan desde Panel → Credenciales ML.
#ML_REDIRECT_URI=
#ML_AUTH_URL=https://auth.mercadolibre.cl
#ML_EXPORT_MAX_ITEMS=1000

# ── Walmart Chile Marketplace ──
# Client ID y Secret se guardan por tienda en walmart_connections.
#WALMART_API_BASE_URL=https://marketplace.walmartapis.com
# WALMART_DRY_RUN (por defecto: false)
#   true  = no se contacta la API real, se devuelven respuestas simuladas
#   false = llamadas reales, incluidas las escrituras de precio y stock
WALMART_DRY_RUN=true

# ── Cencosud Chile Marketplace (Paris.cl) ──
# Client ID y Secret se guardan por tienda en cencosud_connections,
# desde Cencosud → Conectar tienda (/cencosud/connect).
#CENCOSUD_API_BASE_URL=https://api.cencosud.cl
#
# CENCOSUD_DRY_RUN (por defecto: true)
#   true  = modo simulación. CencosudApiHelper intercepta cada petición y
#           devuelve mockups. Es el estado seguro para desarrollo y pruebas.
#   false = llamadas reales a la API de Cencosud.
#
# ANTES DE PONERLO EN false, ver el protocolo de go-live en
# Docs/CERTIFICACION_CENCOSUD_SANDBOX.md. Resumen de requisitos:
#   1. Visto bueno de Cencosud y credenciales oficiales de producción.
#   2. Tienda cargada en /cencosud/connect con Client ID y Client Secret.
#   3. "Probar Conexión" devolviendo HTTP 200 contra la API real.
# Ojo: con la simulación apagada, la sincronización de stock aplica la regla
# de stock crítico (5 unidades o menos en MercadoLibre fuerzan 0 en Cencosud),
# lo que escribe sobre el catálogo real de la tienda.
CENCOSUD_DRY_RUN=true

# ── Seguridad de autenticación ──
#AUTH_MAX_ATTEMPTS=5
#AUTH_LOCKOUT_MINUTES=15
#TWOFA_REMEMBER_SECONDS=604800
#SESSION_IDLE_TIMEOUT=1800
#TFA_MAX_ATTEMPTS=5
#TFA_LOCKOUT_MINUTES=15
#USER_ONLINE_THRESHOLD=120

# ── Límites de peticiones ──
#RATE_LIMIT_LOGIN_MAX=5
#RATE_LIMIT_LOGIN_WINDOW=15
#RATE_LIMIT_2FA_MAX=5
#RATE_LIMIT_2FA_WINDOW=15
#RATE_LIMIT_IMPORT_MAX=3
#RATE_LIMIT_IMPORT_WINDOW=60
#RATE_LIMIT_EXPORT_MAX=10
#RATE_LIMIT_EXPORT_WINDOW=60
#RATE_LIMIT_ADMIN_MAX=20
#RATE_LIMIT_ADMIN_WINDOW=5
#RATE_LIMIT_PASSWORD_RESET_MAX=5
#RATE_LIMIT_PASSWORD_RESET_WINDOW=15
